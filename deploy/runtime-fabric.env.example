# The Chancellor — IZAKHONO Runtime Fabric verification
# Copy outside source control and set real target URLs plus the approved immutable release ID.

IZAKHONO_PRODUCT=the-chancellor
IZAKHONO_RELEASE_ID=replace-with-approved-40-character-commit-sha
IZAKHONO_HEALTH_PATH=/api/health
IZAKHONO_HEALTH_TIMEOUT_SECONDS=5

# Owned targets. Leave unavailable targets blank.
IZAKHONO_TARGET_1_NAME=OWNED-PRIMARY
IZAKHONO_TARGET_1_URL=
IZAKHONO_TARGET_2_NAME=OWNED-SECONDARY
IZAKHONO_TARGET_2_URL=
IZAKHONO_TARGET_3_NAME=OWNED-TERTIARY
IZAKHONO_TARGET_3_URL=
IZAKHONO_TARGET_4_NAME=OWNED-DR
IZAKHONO_TARGET_4_URL=

# Backend-capable external resilience only.
# Do not place the static Vercel fallback here because it does not expose /api/health.
IZAKHONO_EXTERNAL_NAME=EXTERNAL-RESILIENCE
IZAKHONO_EXTERNAL_URL=
