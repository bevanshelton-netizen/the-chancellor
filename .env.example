PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.co.za
ADMIN_PASSWORD=replace-with-a-strong-password
APP_URL=http://localhost:3000
DATA_DIR=./data

# OpenAI is optional. Without it, the safe guided adviser remains active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=cedar

# PayFast. Keep sandbox until every checkout and ITN flow passes testing.
# PAYFAST_PASSPHRASE is required for recurring Professional Network subscriptions.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# Case billing: fraction of professional case fees retained by The Chancellor.
# 0.10 = 10%. Review commercial/legal treatment before changing.
CASE_PLATFORM_FEE_RATE=0.10

# Automated operational communications.
# Email uses Resend. Leave blank to keep email disabled safely.
RESEND_API_KEY=
COMMS_FROM_EMAIL=The Chancellor <notifications@example.co.za>
# Mobile channel may be sms or whatsapp.
COMMS_MOBILE_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Admin operational alerts can use separate destinations.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
# Internal reminder scan; minimum enforced interval is 15 minutes.
COMMS_SCAN_INTERVAL_MINUTES=30

# Upload controls
MAX_UPLOAD_MB=10
MAX_DELIVERABLE_MB=20
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png
