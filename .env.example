PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.co.za
ADMIN_PASSWORD=replace-with-a-strong-password
APP_URL=http://localhost:3000
DATA_DIR=./data

# OpenAI is optional. Without it, the safe guided adviser remains active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PayFast: set PAYFAST_MODE=live only after successful sandbox testing.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=

# Automated operational communications
# Email uses Resend. Leave blank to keep email disabled safely.
RESEND_API_KEY=
COMMS_FROM_EMAIL=The Chancellor <notifications@example.co.za>
# Mobile channel may be sms or whatsapp.
COMMS_MOBILE_CHANNEL=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Admin operational alerts can use separate destinations.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
# Internal reminder scan; minimum enforced interval is 15 minutes.
COMMS_SCAN_INTERVAL_MINUTES=30

# Upload controls
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png
